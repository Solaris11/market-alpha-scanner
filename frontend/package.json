{
  "name": "market-alpha-scanner-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "monitoring:cleanup": "tsx scripts/monitoring-cleanup.ts",
    "monitoring:scale": "node scripts/scale-readiness-probe.mjs",
    "monitoring:synthetics": "tsx scripts/monitoring-synthetics.ts",
    "monitoring:system": "tsx scripts/monitoring-system.ts",
    "marketing:qr": "node scripts/generate-marketing-qr.mjs",
    "narrative:refresh": "tsx scripts/narrative-refresh.ts",
    "shock:refresh": "tsx scripts/shock-pattern-refresh.ts",
    "stripe:reconcile": "tsx scripts/stripe-reconcile.ts",
    "email:test": "node scripts/send-test-email.mjs",
    "test:mobile-ux": "node scripts/mobile-ux-smoke.mjs",
    "test:browserstack": "BROWSERSTACK_CONFIG_FILE=../browserstack.yml npx browserstack-node-sdk playwright test --config=playwright.phase21.config.ts --workers=1",
    "test:browserstack:mobile": "BROWSERSTACK_CONFIG_FILE=../browserstack.yml TRADEVETO_MOBILE_UX_BASE_URL=https://tradeveto.com npx browserstack-node-sdk playwright test --config=playwright.phase21.config.ts --workers=1",
    "test:phase21:mobile-real-device": "npm run test:browserstack:mobile",
    "test:phase22:mobile-real-device": "BROWSERSTACK_CONFIG_FILE=../browserstack.yml TRADEVETO_MOBILE_UX_BASE_URL=https://tradeveto.com TRADEVETO_BROWSERSTACK_ARTIFACT_ROOT=../docs/ops/artifacts/phase-22-1 npx browserstack-node-sdk playwright test --config=playwright.phase21.config.ts --workers=1",
    "probe:phase21:authenticated": "TRADEVETO_SCALE_BASE_URL=https://tradeveto.com TRADEVETO_SCALE_ITERATIONS=100 TRADEVETO_SCALE_CONCURRENCY=25 TRADEVETO_SCALE_TIMEOUT_MS=8000 node scripts/scale-readiness-probe.mjs",
    "probe:phase21:critical-performance": "TRADEVETO_SCALE_BASE_URL=https://tradeveto.com TRADEVETO_SCALE_CONCURRENCY=25 TRADEVETO_SCALE_DURATION_SECONDS=60 TRADEVETO_SCALE_STREAM_CONNECTIONS=25 TRADEVETO_SCALE_STREAM_DURATION_SECONDS=35 TRADEVETO_SCALE_TIMEOUT_MS=8000 node scripts/phase21-critical-performance-probe.mjs",
    "probe:phase21:resilience-chaos": "TRADEVETO_RESILIENCE_BASE_URL=https://tradeveto.com TRADEVETO_RESILIENCE_TIERS=25,50,100 TRADEVETO_RESILIENCE_DURATION_SECONDS=60 TRADEVETO_RESILIENCE_STREAM_CONNECTIONS=25 TRADEVETO_RESILIENCE_STREAM_DURATION_SECONDS=35 TRADEVETO_RESILIENCE_TIMEOUT_MS=8000 node scripts/phase21-resilience-chaos-probe.mjs",
    "probe:phase22:authenticated-scale": "TRADEVETO_PHASE22_BASE_URL=https://tradeveto.com TRADEVETO_PHASE22_TIERS=25,50,100 TRADEVETO_PHASE22_DURATION_SECONDS=900 TRADEVETO_PHASE22_STREAM_TIERS=25,50,100 TRADEVETO_PHASE22_TIMEOUT_MS=8000 node scripts/phase22-authenticated-scale-resilience-probe.mjs",
    "probe:phase22:scanner-workflow": "TRADEVETO_PHASE22_SCANNER_BASE_URL=https://tradeveto.com TRADEVETO_PHASE22_SCANNER_TIERS=25,50 TRADEVETO_PHASE22_SCANNER_DURATION_SECONDS=300 TRADEVETO_PHASE22_SCANNER_TIMEOUT_MS=8000 node scripts/phase22-scanner-workflow-probe.mjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nivo/heatmap": "^0.99.0",
    "@sentry/nextjs": "10.51.0",
    "@visx/gradient": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "bcryptjs": "3.0.3",
    "csv-parse": "6.2.1",
    "echarts": "6.0.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "nodemailer": "8.0.7",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "^3.8.1",
    "server-only": "0.0.1",
    "stripe": "22.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/node": "25.6.0",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "@zxing/library": "^0.21.3",
    "browserstack-node-sdk": "^1.55.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "postcss": "8.5.14"
  }
}
